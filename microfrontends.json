{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "applications": {
    "dailie": {
      "development": {
        "fallback": "www.thewizardofops.app"
      }
    },
    "interface": {
      "packageName": "interface-flow",
      "routing": [
        {
          "group": "production-tracking",
          "paths": [
            "/production",
            "/production/:path*"
          ]
        }
      ]
    }
  }
}
